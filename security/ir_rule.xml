    IMPORTANT:
    Record rules are conjunctive (combined with AND). A rule like:
        [('privacy', '=', 'public')]
    applied to base.group_user will RESTRICT calendar visibility to public events only,
    hiding normal meetings and pending invitations.

    This module already makes holiday events public/free and ensures visibility via
    calendar filters (see hooks.py). Therefore, the rule below is intentionally
    kept DISABLED to avoid breaking meeting/invitation visibility.
-->
<odoo>
    <!-- Disabled on purpose: see IMPORTANT note above. -->
    <record id="calendar_event_public_read_rule" model="ir.rule">
        <field name="name">Calendar: Read Public Events (All Users)</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="domain_force">[('privacy', '=', 'public')]</field>
        <field name="active" eval="False"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <!-- Keep attached to 'no one' to avoid accidental activation impact.
             Use (6, 0, ...) to REPLACE groups and remove any legacy attachments. -->
        <field name="groups" eval="[(6, 0, [ref('base.group_no_one')])]"/>
    </record>
</odoo>

