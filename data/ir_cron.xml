<odoo>
    <data noupdate="1">
        <!-- Scheduled action to sync public holidays from Nager.Date API -->
        <record id="ir_cron_nagerdate_sync" model="ir.cron">
            <field name="name">Public Holidays: Nager.Date Sync</field>
            <field name="model_id" ref="model_nagerdate_settings"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_all_settings()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="priority">100</field>
        </record>
    </data>
</odoo>
